// ============================================================
// FATURA ONAY SÜRECİ - VERİTABANI ŞEMASI (DBML) - v2 (konuşarak netleşen final tasarım)
// dbdiagram.io içine yapıştırıp görselleştirebilirsin:
// https://dbdiagram.io/d  (ücretsiz, kayıt gerekmez)
// ============================================================

// ---------------- AUTH DB (mevcut UserDbContext) ----------------
// MERKEZİ kullanıcı veritabanı: Fatura Takip, DÖF Takip ve gelecekteki TÜM
// şirket içi sistemler AYNI Auth DB'yi kullanır. Kullanıcı/departman/rol/izin
// bir kez tanımlanır. Sistem bazlı ayrım ayrı bir tabloyla DEĞİL, izin ve rol
// ADLARINDAKİ ön ekle sağlanır (ör. invoice.approve, dof.approve).

Table departments {
  id int [pk, increment, note: 'Departmanın benzersiz kimliği']
  name varchar(50) [not null, note: 'Departman adı (ör. Satınalma, Depo, Kalite)']
  description varchar(100) [note: 'Departmanla ilgili kısa açıklama']
  is_active bool [not null, default: true, note: 'Departman hâlâ kullanımda mı (pasif olan departmana yeni atama yapılmaz)']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE - dolu ise kayıt silinmiş sayılır, fiziksel DELETE yapılmaz']

  Note: "AUTH DB"
}

Table roles {
  id int [pk, increment, note: 'Rolün benzersiz kimliği']
  name varchar(50) [not null, unique, note: 'Rolün sistemsel/teknik adı - farklı sistemlerin rolleri karışmasın diye ön ekli adlandırma önerilir (ör. invoice.approver, dof.approver)']
  display_name varchar(100) [not null, note: 'Ekranda gösterilecek okunabilir rol adı']
  description text [note: 'Rolün ne işe yaradığına dair açıklama']
  is_active bool [not null, default: true, note: 'Rol hâlâ atanabilir mi']
  department_id int [note: 'FK -> departments.id, bu rol hangi departmana ait']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table permissions {
  id int [pk, increment, note: 'İznin benzersiz kimliği']
  name varchar(50) [not null, note: 'İznin sistemsel/teknik adı']
  display_name varchar(100) [not null, note: 'Ekranda gösterilecek okunabilir izin adı']
  is_active bool [not null, default: true, note: 'İzin hâlâ kullanımda mı']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table users {
  id int [pk, increment, note: 'Kullanıcının benzersiz kimliği']
  full_name varchar(100) [not null, note: 'Ad soyad']
  email varchar(100) [not null, unique, note: 'Giriş ve bildirim için e-posta adresi']
  password_hash varchar(255) [not null, note: 'Şifrenin hash\'lenmiş hâli (asla düz metin tutulmaz)']
  is_active bool [not null, default: true, note: 'Hesap aktif mi, pasifse giriş yapamaz']
  is_verified bool [not null, default: false, note: 'E-posta doğrulaması yapıldı mı']
  department_id int [note: 'FK -> departments.id, kullanıcının bağlı olduğu departman (fatura sisteminde "Satınalma\'daki kullanıcılar" gibi sorgular için)']
  phone varchar(20) [note: 'Telefon numarası (opsiyonel, ileride SMS doğrulama için)']
  failed_login_count int [not null, default: 0, note: 'Art arda başarısız giriş denemesi sayısı (başarılı girişte sıfırlanır)']
  locked_until datetime [note: 'Brute-force koruması: dolu ve gelecekte ise hesap bu zamana kadar KİLİTLİ, giriş denenemez']
  last_login_at datetime [note: 'Son başarılı giriş zamanı (güvenlik + pasif kullanıcı raporu)']
  password_changed_at datetime [note: 'Şifrenin en son değiştirildiği zaman (şifre yaşı politikası için)']
  position varchar(100) [note: 'Unvan/pozisyon']
  is_out_of_office bool [not null, default: false, note: 'Kullanıcı şu an izinli/müsait değil mi - kendisi veya yöneticisi işaretler. Workflow atama motoru bu bayrağa bakarak invoice_type_step_approvers zincirinde bir sonraki öncelikli kişiye otomatik geçer']
  out_of_office_until datetime [note: 'İzin/müsaitsizlik bitiş tahmini (bilgi amaçlı, otomatik kapatma için kullanılabilir)']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table user_roles {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  user_id int [not null, note: 'FK -> users.id, role\'ün atandığı kullanıcı']
  role_id int [not null, note: 'FK -> roles.id, atanan rol']
  assigned_at datetime [note: 'Rolün atandığı zaman']
  assigned_by int [note: 'FK -> users.id, rolü kim atadı']
  expires_at datetime [note: 'Rolün süresi doluyorsa bitiş zamanı (geçici yetkilendirme için)']
  is_active bool [not null, default: true, note: 'Atama hâlâ geçerli mi']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table role_permissions {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  role_id int [not null, note: 'FK -> roles.id, izin verilen rol']
  permission_id int [not null, note: 'FK -> permissions.id, verilen izin']
  granted_by int [note: 'FK -> users.id, izni kim verdi']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table user_files {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  user_id int [not null, note: 'FK -> users.id, dosyanın sahibi']
  file_kind varchar(20) [not null, note: 'enum: PROFILE_PHOTO / SIGNATURE - profil resmi ve ıslak imza taraması']
  original_file_name varchar(255) [not null, note: 'Kullanıcının yüklediği orijinal ad (sadece görüntüleme; diskte bu ad KULLANILMAZ)']
  nas_relative_path varchar(500) [not null, note: 'NAS üzerindeki bağıl yol, örn. users/signatures/42/a3f1c8e2.png - TAM UNC yolu DB\'de tutulmaz, kök yol appsettings\'tedir']
  content_type varchar(50) [not null, note: 'image/png, image/jpeg, image/webp - yalnızca resim kabul edilir']
  file_size_bytes int [note: 'Dosya boyutu (byte) - yükleme limiti kontrolü için']
  checksum_sha256 varchar(64) [note: 'Dosya bütünlüğü / aynı dosyanın tekrar yüklenmesini tespit']
  is_current bool [not null, default: true, note: 'Aynı file_kind için aktif dosya. Yeni yüklemede eski satır is_current=false olur, fiziksel dosya NAS\'ta kalır (geçmiş imzalı belgeler bozulmasın)']
  uploaded_by_user_id int [note: 'FK -> users.id, yükleyen (kendi profili veya admin)']
  created_at datetime [not null, note: 'Yükleme zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE - kayıt ve NAS dosyası durur, uygulama "silinmiş" sayar']

  Note: "AUTH DB - profil ve imza görselleri NAS'ta tutulur, DB sadece metadata + bağıl yol tutar. Dosya ASLA wwwroot/public URL ile sunulmaz; yalnızca giriş yapmış kullanıcının yetkili API endpoint'i üzerinden okunur. İmza profil resminden daha hassastır (yetki: kendi dosyası veya admin)."

  indexes {
    (user_id, file_kind, is_current) [name: 'ix_user_file_current']
  }
}

Table user_verification_codes {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  user_id int [not null, note: 'FK -> users.id, kod hangi kullanıcı için üretildi']
  code_hash varchar(255) [not null, note: 'Kodun hash\'lenmiş hâli - kod ASLA düz metin tutulmaz (DB sızarsa kodlar kullanılamasın)']
  purpose varchar(30) [not null, note: 'enum: EMAIL_VERIFY / PASSWORD_RESET / LOGIN_2FA - aynı tablo üç senaryoyu da karşılar']
  expires_at datetime [not null, note: 'Kodun geçerlilik bitişi (örn. üretimden 10 dk sonra)']
  used_at datetime [note: 'Kod başarıyla kullanıldıysa ne zaman kullanıldığı (dolu ise kod bir daha KULLANILAMAZ)']
  attempt_count int [not null, default: 0, note: 'Bu kod için yapılan yanlış deneme sayısı (örn. 5 denemede kod iptal edilir)']
  created_at datetime [not null, note: 'Kodun üretildiği zaman']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB - e-posta doğrulama, şifre sıfırlama ve girişte e-posta kodu (2FA) için ortak tablo. Kod üretilince eski aktif kodlar (aynı user+purpose) geçersiz sayılmalı."

  indexes {
    (user_id, purpose, expires_at) [name: 'ix_verification_lookup']
  }
}

Table refresh_tokens {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  user_id int [not null, note: 'FK -> users.id, token hangi kullanıcıya ait']
  token_hash varchar(255) [not null, note: 'Refresh token\'ın hash\'lenmiş hâli - düz metin tutulmaz']
  expires_at datetime [not null, note: 'Token geçerlilik bitişi (örn. 7-30 gün)']
  revoked_at datetime [note: 'Token iptal edildiyse ne zaman (çıkış yapma / "tüm cihazlardan çıkış" / şüpheli durum)']
  replaced_by_token_id int [note: 'FK -> refresh_tokens.id, rotasyonda bu token\'ın yerine üretilen yeni token (çalıntı token tespiti: iptal edilmiş token tekrar kullanılırsa tüm zincir iptal edilir)']
  created_by_ip varchar(45) [note: 'Token\'ın üretildiği IP adresi']
  created_at datetime [not null, note: 'Token\'ın üretildiği zaman']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB - JWT access token kısa ömürlü (örn. 15 dk) tutulur, oturum bu tablodaki refresh token ile uzatılır. Böylece çalınan oturum iptal edilebilir."

  indexes {
    user_id
    token_hash
  }
}

Table auth_activity_logs {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  user_id int [note: 'FK -> users.id, işlemi yapan/işleme konu kullanıcı (başarısız girişte e-posta bilinse de kullanıcı bulunamayabilir, o yüzden nullable)']
  activity_type varchar(40) [not null, note: 'enum: LOGIN_SUCCESS / LOGIN_FAILED / LOGOUT / PASSWORD_CHANGED / PASSWORD_RESET_REQUESTED / PASSWORD_RESET_COMPLETED / EMAIL_VERIFIED / ACCOUNT_LOCKED / ACCOUNT_UNLOCKED / ROLE_ASSIGNED / ROLE_REVOKED']
  description varchar(500) [note: 'Ek detay (örn. hangi rol atandı, kilitlenme sebebi)']
  ip_address varchar(45) [note: 'İşlemin yapıldığı IP adresi']
  user_agent varchar(300) [note: 'Tarayıcı/cihaz bilgisi']
  created_at datetime [not null, note: 'İşlemin gerçekleştiği zaman']
  deleted_at datetime [note: 'SOFT DELETE - normalde log silinmez, sadece istisnai temizlik için']

  Note: "AUTH DB - kimlik doğrulama ve yetkilendirme denetim izi. Append-only, güncellenmez/silinmez."

  indexes {
    (user_id, created_at) [name: 'ix_auth_log_user_time']
    activity_type
  }
}

// ============================================================
// INVOICE DB (yeni tasarım)
// ============================================================

// ---------------- Döviz / Kur ----------------

Table exchange_rates {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  currency_code varchar(10) [not null, note: 'USD, EUR ...']
  rate_date date [not null, note: 'Bu kurun geçerli olduğu gün']
  rate_to_try decimal(18,6) [not null, note: '1 birim dövizin TL karşılığı']
  source varchar(30) [not null, default: 'TCMB', note: 'TCMB / MANUAL']
  created_at datetime [not null, note: 'Bu kur satırının sisteme ne zaman kaydedildiği']

  Note: "INVOICE DB - her gün 1 kez background job ile doldurulur, fatura anında canlı API çağrısı yapılmaz"

  indexes {
    (currency_code, rate_date) [unique, name: 'uq_exchange_rate_day']
  }
}

// ---------------- Fatura Türü ve Sabit Departman Zinciri ----------------

Table invoice_types {
  id int [pk, increment, note: 'Fatura türünün benzersiz kimliği']
  code varchar(30) [not null, unique, note: 'Sistemsel/teknik kod (kod tarafında sabit referans olarak kullanılır)']
  name varchar(100) [not null, note: 'Ekranda gösterilecek okunabilir ad']
  is_active bool [not null, default: true, note: 'Bu tür hâlâ kullanımda mı, pasifse yeni fatura bu türe atanamaz']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE - master data fiziksel silinmez, geçmiş faturalar hâlâ bu kayda referans veriyor olabilir']

  Note: "INVOICE DB - master data. Örn: MALZEME_FATURASI, HIZMET_FATURASI, DENETIM_BELGELENDIRME, EGITIM, NAKLIYE"
}

Table invoice_type_steps {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_type_id int [not null, note: 'FK -> invoice_types.id, bu adım hangi fatura türüne ait']
  step_order int [not null, note: 'GERÇEK, boşluksuz sıra (1,2,3,4,5,6...) - bu fatura türü için akışın TEK kaynağı. Backend ORDER BY step_order ile bu tabloyu baştan sona okuyup ilerler, kodda sabit/hardcoded bir liste YOKTUR']
  step_name varchar(150) [not null, note: 'Ekranda gösterilecek adım adı, ör. "Muhasebe Kontrol", "Gökhan Zerin Kontrolü", "Murat Bolat Denetim"']
  step_role_tag varchar(30) [note: 'Opsiyonel sistemsel etiket: ERP_CONTROL / ACCOUNTING / ARCHIVE / AUDITOR / CONTROL / DEPARTMENT - otomasyon/raporlama hook\'ları için (backend özel davranış gerektiren adımları bu etiketle tanır), zorunlu değil']
  department_id int [note: 'SoftFK -> Auth DB departments.id, opsiyonel - adım kişiye özel değil, departman havuzuna açılacaksa dolu (bu durumda invoice_type_step_approvers boş kalır)']
  max_duration_days decimal(5,2) [note: 'bu adımın SLA süresi (iş günü)']
  is_active bool [not null, default: true, note: 'Bu adım hâlâ kullanımda mı']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - master data. Bir fatura türünün TÜM akışı (ERP kontrol, departman kontrolleri, denetçiler, muhasebe, arşiv dahil) burada tek ve düz bir sıralı liste olarak tanımlanır. step_role_tag opsiyoneldir, sadece backend'in özel davranış tetiklemesi gereken adımlar için kullanılır. Kişiye özel adımlarda sorumlu(lar) invoice_type_step_approvers tablosundan gelir (default_user_id burada TUTULMAZ - çifte kaynak olmasın diye). Örn (Kalite Güvence): 1:Muhasebe, 2:Buse Özdemir, 3:Gökhan Zerin, 4:Muhasebe, 5:Murat Bolat(denetçi), 6:Ali Bey."

  indexes {
    (invoice_type_id, step_order) [unique, name: 'uq_invoice_type_step_order']
  }
}

Table invoice_type_step_approvers {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_type_step_id int [not null, note: 'FK -> invoice_type_steps.id, bu öncelik zinciri hangi adıma ait']
  user_id int [not null, note: 'SoftFK -> Auth DB users.id, onaylayabilecek aday']
  priority int [not null, note: '1 = asıl/ilk bakan, 2 = 1 numara müsait değilse (users.is_out_of_office=true) devreye giren, 3 = sıradaki... Atama motoru bu sırayla ilk MÜSAİT adaya düşer']
  is_active bool [not null, default: true, note: 'Bu aday hâlâ zincirde mi']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - master data. Kişiye özel adımlarda (department_id NULL) bu tablo onaylayabilecek aday(lar)ı öncelik sırasıyla listeler. Atama anında sistem priority ASC sırayla users.is_out_of_office=false olan İLK adayı assigned_user_id yapar. Zincirdeki HERKES aynı anda müsait değilse, invoice_workflow_steps.assigned_user_id NULL bırakılıp adımın assigned_department_id'si üzerinden o departmanın yöneticisine (Auth DB'de departman bazlı yönetici rolü) düşer ve AdminWrite izinli kullanıcılara bildirim gider."

  indexes {
    (invoice_type_step_id, priority) [unique, name: 'uq_step_approver_priority']
    (invoice_type_step_id, user_id) [unique, name: 'uq_step_approver_user']
  }
}

// ---------------- Tedarikçi (Cari) ----------------

Table supplier_categories {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  name varchar(100) [not null, note: 'Kategori adı (ör. Belgelendirme Kuruluşu, Nakliye Firması)']
  is_active bool [not null, default: true, note: 'Kategori hâlâ kullanımda mı']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - sadece sınıflandırma/raporlama amaçlı (departman ataması YAPMAZ). Örn: Belgelendirme Kuruluşu, Nakliye Firması"
}

Table suppliers {
  id int [pk, increment, note: 'Tedarikçinin (carinin) benzersiz kimliği']
  vkn_tckn varchar(11) [not null, unique, note: 'Vergi Kimlik No / TC Kimlik No - firmanın benzersiz kimliği']
  name varchar(200) [not null, note: 'Firma unvanı']
  supplier_category_id int [note: 'FK -> supplier_categories.id (sadece etiket/raporlama)']
  is_active bool [not null, default: true, note: 'Firma hâlâ çalışılan bir firma mı']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE - fatura geçmişi bu carilere referans verdiği için fiziksel silme YASAK']

  Note: "INVOICE DB - çalışılan firmalar (cariler). Departman ataması artık burada DEĞİL, invoice_type üzerinden yapılıyor."
}

Table supplier_invoice_types {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  supplier_id int [not null, note: 'FK -> suppliers.id, hangi cari']
  invoice_type_id int [not null, note: 'FK -> invoice_types.id, bu carinin kesebileceği fatura türü']
  is_active bool [not null, default: true, note: 'Bu eşleşme hâlâ geçerli mi']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - bir carinin kesebileceği fatura türü ADAYLARI (çoktan-çoğa). Tek aday varsa otomatik, birden fazla varsa ML/manuel ayrım yapılır."

  indexes {
    (supplier_id, invoice_type_id) [unique, name: 'uq_supplier_invoice_type']
  }
}

// ---------------- Fatura Ana Kaydı ----------------

Table invoices {
  id int [pk, increment, note: 'Faturanın benzersiz kimliği']

  // Harici sistemden gelen ham veri
  external_invoice_id varchar(100) [note: 'Faturanın kaynak sistemdeki (harici web servisindeki) kimliği']
  vkn_tckn varchar(11) [not null, note: 'Faturayı kesen tarafın Vergi/TC Kimlik No\'su']
  invoice_number varchar(50) [not null, note: 'Fatura numarası']
  invoice_date date [not null, note: 'Faturanın kesildiği tarih']
  amount decimal(18,2) [not null, note: 'Faturanın orijinal (kesildiği para biriminde) tutarı']
  currency varchar(10) [not null, default: 'TRY', note: 'enum: TRY / USD / EUR - ayrı lookup tablosu yok']
  supplier_id int [note: 'FK -> suppliers.id, faturayı kesen cari']
  current_account_code varchar(50) [note: 'ERP cari kodu - sadece cari kimliği, fatura türünü AYIRT ETMEZ']
  raw_payload_json text [note: 'Harici servisten gelen ham veri (JSON), denetim izi/geri dönüş amaçlı saklanır']

  // Döviz / kur (snapshot)
  exchange_rate_id int [note: 'SNAPSHOT -> exchange_rates.id, sabit kalır']
  amount_try decimal(18,2) [note: 'amount * exchange_rate.rate_to_try']

  // ERP / mükerrerlik kontrolü
  erp_match_status varchar(30) [note: 'MATCHED / NOT_FOUND / MISMATCH']
  erp_checked_at datetime [note: 'ERP/mükerrerlik kontrolünün yapıldığı zaman']
  erp_source varchar(30) [note: 'LOCAL_DB / ERP_SERVER / BOTH']
  is_duplicate bool [not null, default: false, note: 'Bu fatura mükerrer olarak işaretlendi mi (hızlı filtre için denormalize alan, detay/hangi faturayla ilişkili olduğu invoice_relations tablosunda)']
  error_reason varchar(500) [note: 'Hata/iade sebebinin açıklaması']

  // Fatura türü + otomatik sınıflandırma (ML)
  invoice_type_id int [note: 'FK -> invoice_types.id - ML ile veya tek adaylı cari ise otomatik belirlenir']
  prediction_confidence decimal(5,4) [note: '0.0000 - 1.0000 arası ML güven skoru']
  prediction_model_version varchar(50)
  assignment_method varchar(30) [note: 'SUPPLIER_SINGLE_CANDIDATE / ML_PREDICTION / MANUAL']

  // Süreçteki güncel konum
  // current_invoice_type_step_id BİLEREK burada YOK -
  // çifte kaynak (dual source of truth) riski yaratmamak için "şu an neredeyiz"
  // bilgisi HER ZAMAN invoice_workflow_steps'ten CANLI SORGUYLA türetilir:
  //   SELECT TOP 1 * FROM invoice_workflow_steps
  //   WHERE invoice_id = @id AND completed_at IS NULL
  //   ORDER BY started_at DESC
  // Bu satır faturanın o anki tek ve gerçek konumudur, invoices tablosunda
  // ayrıca senkronize tutulması gereken bir kopya YOKTUR.
  assigned_user_id int [note: 'SoftFK -> Auth DB users.id']
  auditor1_user_id int [note: 'SoftFK -> Auth DB users.id']
  auditor2_user_id int [note: 'SoftFK -> Auth DB users.id']

  current_status varchar(40) [not null, note: 'enum InvoiceStatus - faturanın o anki genel durumu (dashboard/filtreleme için). Adım bazında DETAY için invoice_workflow_steps sorgulanır, current_invoice_type_step_id gibi ayrıca senkronize edilmesi gereken bir kopya burada TUTULMAZ']

  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE - mali/denetim kaydı olduğu için fiziksel DELETE asla yapılmaz']

  Note: "INVOICE DB"

  indexes {
    (vkn_tckn, invoice_number, amount) [unique, name: 'uq_invoice_dedup']
    current_status
    supplier_id
    invoice_type_id
  }
}

Table invoice_line_items {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturaya ait']
  description varchar(500) [not null, note: 'ML ve manuel sınıflandırma için ana veri kaynağı']
  quantity decimal(18,4) [note: 'Malzeme/hizmet miktarı']
  unit_price decimal(18,4) [note: 'Birim fiyat']
  line_amount decimal(18,2) [note: 'Bu kalemin toplam tutarı (quantity * unit_price)']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - faturanın kalemleri (e-fatura/ERP'den gelir)"
}

// ---------------- Faturalar Arası İlişkiler (mükerrer, fiyat farkı, alacak dekontu vb.) ----------------

Table invoice_relations {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, ilişkiyi taşıyan/yeni fatura (ör. fiyat farkı faturası)']
  related_invoice_id int [not null, note: 'FK -> invoices.id, bağlı olduğu asıl/orijinal fatura']
  relation_type varchar(30) [not null, note: 'enum InvoiceRelationType: DUPLICATE_OF / PRICE_DIFFERENCE_OF / CREDIT_NOTE_OF - ilişkinin türüne göre iş süreci (workflow) farklılaşabilir']
  note varchar(500) [note: 'İlişkiyle ilgili serbest açıklama (opsiyonel)']
  created_by_user_id int [note: 'SoftFK -> Auth DB users.id, ilişkiyi kim kurdu (otomatik ERP kontrolüyse null)']
  created_at datetime [not null, note: 'Kayıt oluşturulma zamanı']

  Note: "INVOICE DB - iki fatura arasındaki mükerrer/fiyat farkı/alacak dekontu gibi ilişkileri tek noktadan yönetir. Append-only, silinmez. Yeni ilişki türleri (relation_type) kod değiştirmeden eklenebilir."

  indexes {
    invoice_id
    related_invoice_id
    (invoice_id, related_invoice_id, relation_type) [unique, name: 'uq_invoice_relation']
  }
}

// ---------------- Ters / İstisna Durum Kuralları (Red, Eksik Evrak vb. Geri Dönüşler) ----------------

Table workflow_transition_rules {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  trigger_action varchar(40) [not null, note: 'Bu kuralı tetikleyen olay: MISSING_DOCUMENT_FLAGGED / AUDITOR1_REJECTED / AUDITOR2_REJECTED vb. (enum WorkflowActionType ile aynı değer kümesi)']
  source_step_id int [note: 'FK -> invoice_type_steps.id, bu kural HANGİ adımda tetiklenirse geçerli. NULL ise bu fatura türü içinde her adımdan tetiklenebilir']
  target_step_id int [not null, note: 'FK -> invoice_type_steps.id, tetiklenince GİDİLECEK adım - ör. AUDITOR_REJECTED -> Muhasebe adımı']
  priority int [not null, default: 100, note: 'Birden fazla kural eşleşirse hangisi önce uygulanır (küçük sayı = önce)']
  is_active bool [not null, default: true, note: 'Kural hâlâ geçerli mi']
  created_at datetime [note: 'Kayıt oluşturulma zamanı']
  updated_at datetime [note: 'Son güncellenme zamanı']
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - master data. 'Hangi tetikleyicide hangi adıma dönülür' kuralını KOD DEĞİŞTİRMEDEN yönetilebilir hale getirir. Kural artık invoice_type_steps'e doğrudan referans verdiği için otomatik olarak tek bir fatura türü kapsamında kalır (source/target aynı invoice_type_id'ye ait olmalı - uygulama seviyesinde doğrulanır). Ör: (trigger=MISSING_DOCUMENT_FLAGGED, source=NULL, target=Muhasebe adımı), (trigger=AUDITOR_REJECTED, source=Denetçi adımı, target=Muhasebe adımı)"

  indexes {
    (trigger_action, source_step_id) [name: 'ix_transition_rule_lookup']
  }
}

// ---------------- Adım Geçmişi (hem sabit adımlar hem departman zinciri için TEK instance tablosu) ----------------

Table invoice_workflow_steps {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturaya ait']

  invoice_type_step_id int [not null, note: 'FK -> invoice_type_steps.id, bu fatura türünün sabit sıralı akışındaki hangi adımın örneği olduğu']

  assigned_user_id int [note: 'SoftFK -> Auth DB users.id']
  assigned_department_id int [note: 'SoftFK -> Auth DB departments.id (denormalize, hızlı filtre için)']

  started_at datetime [not null, note: 'Bu adımın başladığı zaman']
  due_at datetime [note: 'SLA bitiş zamanı']
  completed_at datetime [note: 'Adımın tamamlandığı zaman (boşsa hâlâ bekliyor demektir)']
  reminder_sent_at datetime [note: 'Hatırlatma maili gönderildiyse ne zaman gönderildiği (tekrar göndermemek için)']
  is_overdue bool [not null, default: false, note: 'SLA süresi geçti mi']

  result varchar(30) [note: 'APPROVED / REJECTED / MISSING_DOCUMENT']
  reject_reason varchar(500) [note: 'Reddedilme/iade sebebinin açıklaması']

  Note: "INVOICE DB - bir adımdan HER geçişte yeni bir satır açılır (iade/tekrar durumunda aynı adım birden fazla kez görünebilir). Append-only log, silinmez. EŞZAMANLILIK: bir adımı tamamlarken UPDATE ... WHERE id=@id AND completed_at IS NULL kullanılmalı; 0 satır etkilenirse adım başkası tarafından zaten işlenmiş demektir - ayrı bir RowVersion/ConcurrencyStamp sütununa gerek yoktur, completed_at bu görevi zaten görür."

  indexes {
    (due_at, completed_at) [name: 'ix_workflow_steps_due']
    (invoice_id, completed_at) [name: 'ix_workflow_steps_current_lookup', note: 'invoices JOIN ile "şu an hangi adımda" sorgusunu tek index-seek ile karşılar (invoice_id bazında completed_at IS NULL olan en fazla 1 satır olur)']
  }
}

// ---------------- Durum Değişikliği Geçmişi (append-only denetim izi) ----------------

Table invoice_workflow_history {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturaya ait']
  action_type varchar(40) [not null, note: 'enum WorkflowActionType']
  from_status varchar(40) [note: 'Değişiklikten önceki durum']
  to_status varchar(40) [not null, note: 'Değişiklikten sonraki durum']
  actor_user_id int [note: 'SoftFK -> Auth DB users.id (sistem işlemiyse null)']
  reason varchar(1000) [note: 'Değişikliğin açıklaması/gerekçesi']
  created_at datetime [not null, note: 'Değişikliğin gerçekleştiği zaman']

  Note: "INVOICE DB - SADECE durum/adım değişikliklerini (onay, red, iade) tutar. Append-only log, silinmez."
}

// ---------------- Kullanıcı Aktivite Logu (gördü/açtı/indirdi/yorum yaptı) ----------------

Table invoice_activity_logs {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturaya ait']
  workflow_step_id int [note: 'FK -> invoice_workflow_steps.id (opsiyonel, hangi adımda olduğu)']
  user_id int [note: 'SoftFK -> Auth DB users.id, etkileşimi yapan kullanıcı']

  activity_type varchar(30) [not null, note: 'VIEWED / OPENED_ATTACHMENT / DOWNLOADED / COMMENTED / STATUS_CHECKED']
  description varchar(500) [note: 'Etkileşimle ilgili ek detay/açıklama']
  ip_address varchar(45) [note: 'Etkileşimin yapıldığı IP adresi (güvenlik/izlenebilirlik için)']
  created_at datetime [not null, note: 'Etkileşimin gerçekleştiği zaman']

  Note: "INVOICE DB - durum değiştirmeyen, salt gözlemsel kullanıcı etkileşim logu (invoice_workflow_history'den farklı, çok daha ince taneli). Append-only log, silinmez."

  indexes {
    invoice_id
    created_at
  }
}

// ---------------- Dosya Ekleri (NAS) ----------------

Table invoice_attachments {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturaya ait']
  file_name varchar(255) [not null, note: 'Orijinal dosya adı']
  nas_relative_path varchar(500) [not null, note: 'ör: 2026/08/INV_123.pdf - NAS üzerindeki bağıl dosya yolu']
  file_type varchar(30) [not null, default: 'SCANNED_SIGNED_PDF', note: 'Dosyanın türü']
  file_size_bytes int [note: 'Dosya boyutu (byte)']
  checksum_sha256 varchar(64) [note: 'Dosya bütünlüğünü doğrulamak için hash değeri']
  uploaded_by_user_id int [note: 'SoftFK -> Auth DB users.id, dosyayı kim yükledi']
  uploaded_at datetime [not null, note: 'Dosyanın yüklendiği zaman']
  deleted_at datetime [note: 'SOFT DELETE - yanlış yüklenen dosya "silinmiş" işaretlenir, fiziksel kayıt/NAS dosyası durur']

  Note: "INVOICE DB"
}

// ---------------- Bildirim / SLA Mail Logu ----------------

Table invoice_notification_logs {
  id int [pk, increment, note: 'Kaydın benzersiz kimliği']
  invoice_id int [not null, note: 'FK -> invoices.id, hangi faturayla ilgili']
  workflow_step_id int [note: 'FK -> invoice_workflow_steps.id, hangi adımla ilgili']
  recipient_user_id int [note: 'SoftFK -> Auth DB users.id, alıcı kullanıcı']
  recipient_email varchar(150) [not null, note: 'Mailin gönderildiği e-posta adresi']
  notification_type varchar(30) [not null, note: 'ASSIGNED / SLA_REMINDER / SLA_ESCALATED / REJECTED']
  sent_at datetime [not null, note: 'Mailin gönderildiği zaman']
  is_success bool [not null, default: true, note: 'Gönderim başarılı oldu mu']
  error_message varchar(500) [note: 'Gönderim başarısızsa hata mesajı']

  Note: "INVOICE DB"
}

// ============================================================
// İLİŞKİLER (Referansiyel bütünlük)
// ============================================================

// AUTH DB içi gerçek FK'lar
Ref: roles.department_id > departments.id [delete: set null]
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: user_roles.assigned_by > users.id [delete: set null]
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: role_permissions.granted_by > users.id [delete: set null]
Ref: users.department_id > departments.id [delete: set null]
Ref: user_files.user_id > users.id [delete: cascade]
Ref: user_files.uploaded_by_user_id > users.id [delete: set null]
Ref: user_verification_codes.user_id > users.id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: refresh_tokens.replaced_by_token_id > refresh_tokens.id [delete: set null]
Ref: auth_activity_logs.user_id > users.id [delete: set null]

// INVOICE DB içi gerçek FK'lar
Ref: invoice_type_steps.invoice_type_id > invoice_types.id [delete: cascade]
Ref: invoice_type_step_approvers.invoice_type_step_id > invoice_type_steps.id [delete: cascade]
Ref: suppliers.supplier_category_id > supplier_categories.id [delete: set null]
Ref: supplier_invoice_types.supplier_id > suppliers.id [delete: cascade]
Ref: supplier_invoice_types.invoice_type_id > invoice_types.id [delete: cascade]

Ref: invoices.supplier_id > suppliers.id [delete: set null]
Ref: invoices.invoice_type_id > invoice_types.id [delete: set null]
Ref: invoices.exchange_rate_id > exchange_rates.id [delete: set null]
Ref: invoice_line_items.invoice_id > invoices.id [delete: cascade]
Ref: invoice_relations.invoice_id > invoices.id [delete: cascade]
Ref: invoice_relations.related_invoice_id > invoices.id [delete: cascade]

Ref: invoice_workflow_steps.invoice_id > invoices.id [delete: cascade]
Ref: invoice_workflow_steps.invoice_type_step_id > invoice_type_steps.id [delete: restrict]

Ref: workflow_transition_rules.source_step_id > invoice_type_steps.id [delete: set null]
Ref: workflow_transition_rules.target_step_id > invoice_type_steps.id [delete: restrict]

Ref: invoice_workflow_history.invoice_id > invoices.id [delete: cascade]

Ref: invoice_activity_logs.invoice_id > invoices.id [delete: cascade]
Ref: invoice_activity_logs.workflow_step_id > invoice_workflow_steps.id [delete: set null]

Ref: invoice_attachments.invoice_id > invoices.id [delete: cascade]

Ref: invoice_notification_logs.invoice_id > invoices.id [delete: cascade]
Ref: invoice_notification_logs.workflow_step_id > invoice_workflow_steps.id [delete: set null]

// NOT: Aşağıdaki ilişkiler CROSS-DATABASE olduğu için gerçek FK DEĞİL,
// sadece görsel/kavramsal amaçlı "SoftFK" olarak bilgi notu bırakılmıştır.
// Ref: invoice_type_steps.department_id > departments.id
// Ref: invoice_type_step_approvers.user_id > users.id
// Ref: invoices.assigned_user_id > users.id
// Ref: invoices.auditor1_user_id > users.id
// Ref: invoices.auditor2_user_id > users.id
// Ref: invoice_workflow_steps.assigned_user_id > users.id
// Ref: invoice_workflow_steps.assigned_department_id > departments.id
// Ref: invoice_workflow_history.actor_user_id > users.id
// Ref: invoice_activity_logs.user_id > users.id
// Ref: invoice_attachments.uploaded_by_user_id > users.id
// Ref: invoice_relations.created_by_user_id > users.id
// Ref: invoice_notification_logs.recipient_user_id > users.id
