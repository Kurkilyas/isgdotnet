// ============================================================
// FATURA ONAY SÜRECİ - VERİTABANI ŞEMASI (DBML) - v2 (konuşarak netleşen final tasarım)
// dbdiagram.io içine yapıştırıp görselleştirebilirsin:
// https://dbdiagram.io/d  (ücretsiz, kayıt gerekmez)
// ============================================================

// ---------------- AUTH DB (mevcut UserDbContext) ----------------

Table departments {
  id int [pk, increment]
  name varchar(50) [not null]
  description varchar(100)
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE - dolu ise kayıt silinmiş sayılır, fiziksel DELETE yapılmaz']

  Note: "AUTH DB"
}

Table roles {
  id int [pk, increment]
  name varchar(50) [not null]
  display_name varchar(100) [not null]
  description text
  is_active bool [not null, default: true]
  department_id int
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table permissions {
  id int [pk, increment]
  name varchar(50) [not null]
  display_name varchar(100) [not null]
  is_active bool [not null, default: true]
  created_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "AUTH DB"
}

Table users {
  id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  is_active bool [not null, default: true]
  is_verified bool [not null, default: false]
  position varchar(100)
  user_signature_url varchar(500)
  created_at datetime
  updated_at datetime
  deleted_at datetime

  Note: "AUTH DB"
}

Table user_roles {
  id int [pk, increment]
  user_id int [not null]
  role_id int [not null]
  assigned_at datetime
  assigned_by int
  expires_at datetime
  is_active bool [not null, default: true]

  Note: "AUTH DB"
}

Table role_permissions {
  id int [pk, increment]
  role_id int [not null]
  permission_id int [not null]
  granted_by int

  Note: "AUTH DB"
}

// ============================================================
// INVOICE DB (yeni tasarım)
// ============================================================

// ---------------- Döviz / Kur ----------------

Table exchange_rates {
  id int [pk, increment]
  currency_code varchar(10) [not null, note: 'USD, EUR ...']
  rate_date date [not null]
  rate_to_try decimal(18,6) [not null, note: '1 birim dövizin TL karşılığı']
  source varchar(30) [not null, default: 'TCMB', note: 'TCMB / MANUAL']
  created_at datetime [not null]

  Note: "INVOICE DB - her gün 1 kez background job ile doldurulur, fatura anında canlı API çağrısı yapılmaz"

  indexes {
    (currency_code, rate_date) [unique, name: 'uq_exchange_rate_day']
  }
}

// ---------------- Fatura Türü ve Sabit Departman Zinciri ----------------

Table invoice_types {
  id int [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE - master data fiziksel silinmez, geçmiş faturalar hâlâ bu kayda referans veriyor olabilir']

  Note: "INVOICE DB - master data. Örn: MALZEME_FATURASI, HIZMET_FATURASI, DENETIM_BELGELENDIRME, EGITIM, NAKLIYE"
}

Table invoice_type_department_steps {
  id int [pk, increment]
  invoice_type_id int [not null]
  step_order int [not null, note: '1, 2, 3... zincirdeki sırası']
  department_id int [note: 'SoftFK -> Auth DB departments.id']
  max_duration_days decimal(5,2) [note: 'bu departman adımının SLA süresi (iş günü)']
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - master data. Örn: MALZEME_FATURASI -> [1:Satınalma, 2:Depo]. Fatura türüne göre SABİT ve önceden bellidir."

  indexes {
    (invoice_type_id, step_order) [unique, name: 'uq_invoice_type_step_order']
  }
}

// ---------------- Tedarikçi (Cari) ----------------

Table supplier_categories {
  id int [pk, increment]
  name varchar(100) [not null]
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - sadece sınıflandırma/raporlama amaçlı (departman ataması YAPMAZ). Örn: Belgelendirme Kuruluşu, Nakliye Firması"
}

Table suppliers {
  id int [pk, increment]
  vkn_tckn varchar(11) [not null, unique]
  name varchar(200) [not null]
  supplier_category_id int [note: 'FK -> supplier_categories.id (sadece etiket/raporlama)']
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE - fatura geçmişi bu carilere referans verdiği için fiziksel silme YASAK']

  Note: "INVOICE DB - çalışılan firmalar (cariler). Departman ataması artık burada DEĞİL, invoice_type üzerinden yapılıyor."
}

Table supplier_invoice_types {
  id int [pk, increment]
  supplier_id int [not null]
  invoice_type_id int [not null]
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - bir carinin kesebileceği fatura türü ADAYLARI (çoktan-çoğa). Tek aday varsa otomatik, birden fazla varsa ML/manuel ayrım yapılır."

  indexes {
    (supplier_id, invoice_type_id) [unique, name: 'uq_supplier_invoice_type']
  }
}

// ---------------- Fatura Ana Kaydı ----------------

Table invoices {
  id int [pk, increment]

  // Harici sistemden gelen ham veri
  external_invoice_id varchar(100)
  vkn_tckn varchar(11) [not null]
  invoice_number varchar(50) [not null]
  invoice_date date [not null]
  amount decimal(18,2) [not null]
  currency varchar(10) [not null, default: 'TRY', note: 'enum: TRY / USD / EUR - ayrı lookup tablosu yok']
  supplier_id int [note: 'FK -> suppliers.id']
  current_account_code varchar(50) [note: 'ERP cari kodu - sadece cari kimliği, fatura türünü AYIRT ETMEZ']
  raw_payload_json text

  // Döviz / kur (snapshot)
  exchange_rate_id int [note: 'SNAPSHOT -> exchange_rates.id, sabit kalır']
  amount_try decimal(18,2) [note: 'amount * exchange_rate.rate_to_try']

  // ERP / mükerrerlik kontrolü
  erp_match_status varchar(30) [note: 'MATCHED / NOT_FOUND / MISMATCH']
  erp_checked_at datetime
  erp_source varchar(30) [note: 'LOCAL_DB / ERP_SERVER / BOTH']
  is_duplicate bool [not null, default: false]
  duplicate_of_invoice_id int
  error_reason varchar(500)

  // Fatura türü + otomatik sınıflandırma (ML)
  invoice_type_id int [note: 'FK -> invoice_types.id - ML ile veya tek adaylı cari ise otomatik belirlenir']
  prediction_confidence decimal(5,4) [note: '0.0000 - 1.0000 arası ML güven skoru']
  prediction_model_version varchar(50)
  assignment_method varchar(30) [note: 'SUPPLIER_SINGLE_CANDIDATE / ML_PREDICTION / MANUAL']

  // Süreçteki güncel konum
  current_department_step_id int [note: 'FK -> invoice_type_department_steps.id, zincirde şu an neredeyiz']
  assigned_user_id int [note: 'SoftFK -> Auth DB users.id']
  auditor1_user_id int [note: 'SoftFK -> Auth DB users.id']
  auditor2_user_id int [note: 'SoftFK -> Auth DB users.id']

  current_status varchar(40) [not null, note: 'enum InvoiceStatus']
  current_step_code varchar(20)

  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE - mali/denetim kaydı olduğu için fiziksel DELETE asla yapılmaz']

  Note: "INVOICE DB"

  indexes {
    (vkn_tckn, invoice_number, amount) [unique, name: 'uq_invoice_dedup']
    current_status
    supplier_id
    invoice_type_id
  }
}

Table invoice_line_items {
  id int [pk, increment]
  invoice_id int [not null]
  description varchar(500) [not null, note: 'ML ve manuel sınıflandırma için ana veri kaynağı']
  quantity decimal(18,4)
  unit_price decimal(18,4)
  line_amount decimal(18,2)
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - faturanın kalemleri (e-fatura/ERP'den gelir)"
}

// ---------------- Sabit Süreç Adımları (ERP, Denetçi, Muhasebe, Arşiv) ----------------

Table workflow_step_definitions {
  id int [pk, increment]
  code varchar(20) [not null, unique]
  name varchar(150) [not null]
  order_no int [not null]
  responsible_role_type varchar(30) [not null, note: 'ERP_CONTROL / AUDITOR1 / AUDITOR2 / ACCOUNTING / ARCHIVE / SYSTEM']
  max_duration_days decimal(5,2) [not null]
  is_active bool [not null, default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [note: 'SOFT DELETE']

  Note: "INVOICE DB - master data. TÜM fatura türleri için ortak/sabit adımlar (departman zincirinden AYRI)"
}

// ---------------- Adım Geçmişi (hem sabit adımlar hem departman zinciri için TEK instance tablosu) ----------------

Table invoice_workflow_steps {
  id int [pk, increment]
  invoice_id int [not null]

  step_definition_id int [note: 'FK -> workflow_step_definitions.id (sabit adımlarda dolu)']
  department_step_id int [note: 'FK -> invoice_type_department_steps.id (departman zinciri adımlarında dolu)']

  assigned_user_id int [note: 'SoftFK -> Auth DB users.id']
  assigned_department_id int [note: 'SoftFK -> Auth DB departments.id (denormalize, hızlı filtre için)']

  started_at datetime [not null]
  due_at datetime [note: 'SLA bitiş zamanı']
  completed_at datetime
  reminder_sent_at datetime
  is_overdue bool [not null, default: false]

  result varchar(30) [note: 'APPROVED / REJECTED / MISSING_DOCUMENT']
  reject_reason varchar(500)

  Note: "INVOICE DB - bir adımdan HER geçişte yeni bir satır açılır (iade/tekrar durumunda aynı adım birden fazla kez görünebilir). Append-only log, silinmez."

  indexes {
    (due_at, completed_at) [name: 'ix_workflow_steps_due']
    invoice_id
  }
}

// ---------------- Durum Değişikliği Geçmişi (append-only denetim izi) ----------------

Table invoice_workflow_history {
  id int [pk, increment]
  invoice_id int [not null]
  action_type varchar(40) [not null, note: 'enum WorkflowActionType']
  from_status varchar(40)
  to_status varchar(40) [not null]
  actor_user_id int [note: 'SoftFK -> Auth DB users.id (sistem işlemiyse null)']
  reason varchar(1000)
  created_at datetime [not null]

  Note: "INVOICE DB - SADECE durum/adım değişikliklerini (onay, red, iade) tutar. Append-only log, silinmez."
}

// ---------------- Kullanıcı Aktivite Logu (gördü/açtı/indirdi/yorum yaptı) ----------------

Table invoice_activity_logs {
  id int [pk, increment]
  invoice_id int [not null]
  workflow_step_id int [note: 'FK -> invoice_workflow_steps.id (opsiyonel, hangi adımda olduğu)']
  user_id int [note: 'SoftFK -> Auth DB users.id']

  activity_type varchar(30) [not null, note: 'VIEWED / OPENED_ATTACHMENT / DOWNLOADED / COMMENTED / STATUS_CHECKED']
  description varchar(500)
  ip_address varchar(45)
  created_at datetime [not null]

  Note: "INVOICE DB - durum değiştirmeyen, salt gözlemsel kullanıcı etkileşim logu (invoice_workflow_history'den farklı, çok daha ince taneli). Append-only log, silinmez."

  indexes {
    invoice_id
    created_at
  }
}

// ---------------- Dosya Ekleri (NAS) ----------------

Table invoice_attachments {
  id int [pk, increment]
  invoice_id int [not null]
  file_name varchar(255) [not null]
  nas_relative_path varchar(500) [not null, note: 'ör: 2026/08/INV_123.pdf']
  file_type varchar(30) [not null, default: 'SCANNED_SIGNED_PDF']
  file_size_bytes int
  checksum_sha256 varchar(64)
  uploaded_by_user_id int [note: 'SoftFK -> Auth DB users.id']
  uploaded_at datetime [not null]
  deleted_at datetime [note: 'SOFT DELETE - yanlış yüklenen dosya "silinmiş" işaretlenir, fiziksel kayıt/NAS dosyası durur']

  Note: "INVOICE DB"
}

// ---------------- Bildirim / SLA Mail Logu ----------------

Table invoice_notification_logs {
  id int [pk, increment]
  invoice_id int [not null]
  workflow_step_id int
  recipient_user_id int [note: 'SoftFK -> Auth DB users.id']
  recipient_email varchar(150) [not null]
  notification_type varchar(30) [not null, note: 'ASSIGNED / SLA_REMINDER / SLA_ESCALATED / REJECTED']
  sent_at datetime [not null]
  is_success bool [not null, default: true]
  error_message varchar(500)

  Note: "INVOICE DB"
}

// ============================================================
// İLİŞKİLER (Referansiyel bütünlük)
// ============================================================

// AUTH DB içi gerçek FK'lar
Ref: roles.department_id > departments.id [delete: set null]
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: user_roles.assigned_by > users.id [delete: set null]
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: role_permissions.granted_by > users.id [delete: set null]

// INVOICE DB içi gerçek FK'lar
Ref: invoice_type_department_steps.invoice_type_id > invoice_types.id [delete: cascade]
Ref: suppliers.supplier_category_id > supplier_categories.id [delete: set null]
Ref: supplier_invoice_types.supplier_id > suppliers.id [delete: cascade]
Ref: supplier_invoice_types.invoice_type_id > invoice_types.id [delete: cascade]

Ref: invoices.supplier_id > suppliers.id [delete: set null]
Ref: invoices.invoice_type_id > invoice_types.id [delete: set null]
Ref: invoices.exchange_rate_id > exchange_rates.id [delete: set null]
Ref: invoices.duplicate_of_invoice_id > invoices.id [delete: set null]
Ref: invoices.current_department_step_id > invoice_type_department_steps.id [delete: set null]

Ref: invoice_line_items.invoice_id > invoices.id [delete: cascade]

Ref: invoice_workflow_steps.invoice_id > invoices.id [delete: cascade]
Ref: invoice_workflow_steps.step_definition_id > workflow_step_definitions.id [delete: set null]
Ref: invoice_workflow_steps.department_step_id > invoice_type_department_steps.id [delete: set null]

Ref: invoice_workflow_history.invoice_id > invoices.id [delete: cascade]

Ref: invoice_activity_logs.invoice_id > invoices.id [delete: cascade]
Ref: invoice_activity_logs.workflow_step_id > invoice_workflow_steps.id [delete: set null]

Ref: invoice_attachments.invoice_id > invoices.id [delete: cascade]

Ref: invoice_notification_logs.invoice_id > invoices.id [delete: cascade]
Ref: invoice_notification_logs.workflow_step_id > invoice_workflow_steps.id [delete: set null]

// NOT: Aşağıdaki ilişkiler CROSS-DATABASE olduğu için gerçek FK DEĞİL,
// sadece görsel/kavramsal amaçlı "SoftFK" olarak bilgi notu bırakılmıştır.
// Ref: invoice_type_department_steps.department_id > departments.id
// Ref: invoices.assigned_user_id > users.id
// Ref: invoices.auditor1_user_id > users.id
// Ref: invoices.auditor2_user_id > users.id
// Ref: invoice_workflow_steps.assigned_user_id > users.id
// Ref: invoice_workflow_steps.assigned_department_id > departments.id
// Ref: invoice_workflow_history.actor_user_id > users.id
// Ref: invoice_activity_logs.user_id > users.id
// Ref: invoice_attachments.uploaded_by_user_id > users.id
// Ref: invoice_notification_logs.recipient_user_id > users.id
